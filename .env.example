# Server Configuration
# Development: 3003, Production: 3007 (or your preferred port)
PORT=3003
# NOTE: Don't set NODE_ENV in .env file for Vite builds
# Set it as shell environment variable instead: export NODE_ENV=production

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRATION=24h

# CORS Configuration
# Production origins are always allowed: https://messagingmatrix.ai, http://messagingmatrix.ai
# Development origins (localhost) are automatically added in development mode
# Add custom origins as comma-separated list if needed:
# CORS_ORIGINS=http://localhost:8080,http://192.168.1.100:5173

# AI API Keys (optional - for AI features)
# Claude (Anthropic)
VITE_ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Gemini (Google AI)
GEMINI_API_KEY=your-gemini-api-key-here

# Grok (xAI)
GROK_API_KEY=your-grok-api-key-here

# MCP server bearer token (required to enable /mcp endpoint)
# Generate a random string per instance: openssl rand -hex 32
MCP_BEARER_TOKEN=change-me-to-a-long-random-string

# AdForm Reporting — currently reads from a local xlsx export, not the live API.
# Default path (relative to repo root): data/adform-report.xlsx
# Override with an absolute or repo-relative path if needed:
# ADFORM_REPORT_PATH=./data/adform-report.xlsx

# Live API credentials — not used while the xlsx fallback is active. Keep for
# when we re-enable the API path in services/adformService.js.
# ADFORM_CLIENT_ID=your-adform-client-id
# ADFORM_CLIENT_SECRET=your-adform-client-secret
# ADFORM_TOKEN_URL=https://id.adform.com/sts/connect/token
# ADFORM_API_BASE=https://api.adform.com
# ADFORM_SCOPE=https://api.adform.com/scope/buyer.api

# Google Service Account (required for Google Sheets authentication)
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json

# App Configuration
VITE_API_URL=https://messagingmatrix.ai
# Google Drive Storage Configuration
# Instructions:
# 1. Create folders in Google Drive for assets and creatives
# 2. Share those folders with your service account email (found in service-account.json)
# 3. Get folder IDs from the folder URLs (https://drive.google.com/drive/folders/FOLDER_ID_HERE)
# 4. Add the folder IDs to config.json under googleDrive.assetsFolderId and googleDrive.creativesFolderId
# 5. Set googleDrive.enabled to true in config.json
# Note: The same service account used for Google Sheets will be used for Drive
